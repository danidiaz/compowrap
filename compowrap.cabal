cabal-version:      3.14
name:               compowrap
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Daniel Díaz
maintainer:         diaz_carrete@yahoo.com
-- copyright:
category:           Control
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

-- extra-source-files:

common extensions
    default-language: GHC2021

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-N"

library
    import:           extensions
    import:           ghc-options
    exposed-modules:  Compowrap
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.22.0.0
    hs-source-dirs:   lib
    default-language: GHC2024

test-suite compowrap-test
    import:           extensions
    import:           ghc-options
    import:           rts-options
    default-language: GHC2024
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.22.0.0,
        compowrap
